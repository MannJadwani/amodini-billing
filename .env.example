# --- AI helper (OPTIONAL) ---
# The app works fully without any of these. Set a key only if you want the
# "Ask the AI" chat (plain-English bill creation, Q&A). Without a key the app
# shows a friendly "AI helper not configured" message and never crashes.
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=nex-agi/nex-n2-pro:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_TITLE=Simple Billing

# You may instead provide an OpenAI-compatible key:
# OPENAI_API_KEY=your_openai_key
